#!/bin/sh
# Block accidental direct pushes to main.
#
# Installed by `make hooks` (sets core.hooksPath to .githooks).
# Every developer runs that once after cloning.
#
# Bypass for the rare legitimate case (initial push of a fresh repo, reverting a
# broken release at 3am): ALLOW_MAIN_PUSH=1 git push
#
# This is a guard rail, not security: `git push --no-verify` skips it. The point
# is to stop the muscle-memory `git push` on the wrong branch.

remote="$1"
allow="${ALLOW_MAIN_PUSH:-0}"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            if [ "$allow" != "1" ]; then
                echo "" >&2
                echo "pre-push: direct push to main is blocked." >&2
                echo "" >&2
                echo "  work on a branch and open a PR:" >&2
                echo "    git switch -c feat/<name>" >&2
                echo "    git push -u origin feat/<name>" >&2
                echo "" >&2
                echo "  one-off override:" >&2
                echo "    ALLOW_MAIN_PUSH=1 git push" >&2
                echo "" >&2
                status=1
            fi
            ;;
    esac
done

exit $status
