{
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.egg-info": true,
    ".venv": true,
    ".mypy_cache": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".tox": true,
    ".nox": true,
    ".coverage": true,
    ".coverage.*": true,
    "coverage.xml": true,
    "htmlcov": true,
    "build": true,
    "dist": true,
    "models-cache": true,
    "node_modules": true,
    ".ipynb_checkpoints": true,
    "Thumbs.db": true,
    ".DS_Store": true,
    ".import_linter_cache": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.egg-info": true,
    ".venv": true,
    ".mypy_cache": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".tox": true,
    ".nox": true,
    "htmlcov": true,
    "build": true,
    "dist": true,
    "models-cache": true,
    "node_modules": true,
    "uv.lock": true,
    "*.min.js": true,
    "*.min.css": true,
    ".import_linter_cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/models-cache/**": true,
    "**/data/**": true,
    "**/node_modules/**": true,
    "**/htmlcov/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.import_linter_cache/**": true
  },
  "python.analysis.exclude": [
    "**/__pycache__",
    ".venv",
    "models-cache",
    "data",
    "build",
    "dist",
    "tests/fixtures",
    ".import_linter_cache"
  ],
  "python.analysis.extraPaths": [
    "src"
  ],
  "python.defaultInterpreterPath": ".venv\\Scripts\\python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "editor.rulers": [
    120
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "workbench.iconTheme": "material-icon-theme",
  "python.terminal.activateEnvironment": false,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "material-icon-theme.folders.associations": {
    "domain": "core",
    "application": "app",
    "adapters": "api",
    "transport": "routes",
    "engines": "robot",
    "solvers": "target",
    "antibot": "robot",
    "classification": "class",
    "interactive": "api",
    "recaptcha": "api",
    "funcaptcha": "api",
    "score_based": "target",
    "pow": "target",
    "ocr": "images",
    "detection": "images",
    "slider": "other",
    "rotate": "other",
    "crypto": "keys",
    "behavior": "global",
    "observability": "log",
    "jssandbox": "javascript",
    "sidecar_node": "node",
    "profiles": "config",
    "gateway": "server",
    "canary": "test",
    "worker_http": "server",
    "worker_cv": "server",
    "worker_protocol": "server",
    "worker_browser": "server",
    "runbooks": "docs",
    "adr": "docs",
    "playbooks": "docs",
    "versions": "migrations"
  },
  "material-icon-theme.folders.customClones": [
    {
      "name": "captcha-orange",
      "base": "keys",
      "color": "#FB923C",
      "lightColor": "#EA580C",
      "folderNames": [
        "captcha"
      ],
      "rootFolderNames": [
        "captcha"
      ]
    }
  ]
}
