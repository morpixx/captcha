{
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.egg-info": true,
    ".venv": true,
    ".mypy_cache": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".tox": true,
    ".nox": true,
    ".coverage": true,
    ".coverage.*": true,
    "coverage.xml": true,
    "htmlcov": true,
    "build": true,
    "dist": true,
    "models-cache": true,
    "node_modules": true,
    ".ipynb_checkpoints": true,
    "Thumbs.db": true,
    ".DS_Store": true,
    ".import_linter_cache": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.egg-info": true,
    ".venv": true,
    ".mypy_cache": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".tox": true,
    ".nox": true,
    "htmlcov": true,
    "build": true,
    "dist": true,
    "models-cache": true,
    "node_modules": true,
    "uv.lock": true,
    "*.min.js": true,
    "*.min.css": true,
    ".import_linter_cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/models-cache/**": true,
    "**/data/**": true,
    "**/node_modules/**": true,
    "**/htmlcov/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.import_linter_cache/**": true
  },
  "python.analysis.exclude": [
    "**/__pycache__",
    ".venv",
    "models-cache",
    "data",
    "build",
    "dist",
    "tests/fixtures",
    ".import_linter_cache"
  ],
  "python.analysis.extraPaths": [
    "src"
  ],
  "python.defaultInterpreterPath": ".venv\\Scripts\\python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "editor.rulers": [
    120
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "workbench.iconTheme": "material-icon-theme",
  "// icon clone": "folder icons are personal: see docs/workflow.md"
}
