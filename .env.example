# Copy to .env. Compose reads this file for ${VAR} interpolation, and every
# Python service reads it for its own settings. Values below are the defaults
# from src/captcha/config.py unless noted otherwise.

# --- gateway ---------------------------------------------------------------
CAPTCHA_GATEWAY_HOST=0.0.0.0
CAPTCHA_GATEWAY_PORT=8080
CAPTCHA_GATEWAY_WORKERS=4
# How often the sellable type set is re-read from worker heartbeats. Workers
# beat every 30 s with a 90 s TTL; 15-30 s here keeps a dead lane unsellable
# within one TTL instead of until the next gateway restart.
CAPTCHA_TYPES_REFRESH_SEC=20
# Manual additions to the sellable set, comma-separated (e.g. "slider,rotate").
# An escape hatch for a type the solver registry cannot see; it does not replace
# the heartbeat proof, and it cannot open the browser lane.
CAPTCHA_EXTRA_TYPES=

# --- TLS ingress (Caddy) ---------------------------------------------------
# Public hostname Caddy serves. "localhost" gets a certificate from Caddy's
# internal CA; a real domain gets Let's Encrypt.
CAPTCHA_DOMAIN=localhost
# ACME contact address. Empty => internal CA (LAN/staging); set it for a public
# domain or Caddy falls back to the internal CA and browsers will refuse it.
ACME_EMAIL=

# --- redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=captcha

# --- postgres --------------------------------------------------------------
POSTGRES_URL=postgresql+asyncpg://captcha:captcha@localhost:5432/captcha
POSTGRES_POOL_SIZE=20

# --- s3 / minio ------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=captcha
S3_REGION=us-east-1

# --- workers ---------------------------------------------------------------
WORKER_HTTP_CONCURRENCY=512
WORKER_HTTP_CONSUMERS=8
WORKER_HTTP_IMPERSONATE=chrome124
WORKER_PROTOCOL_CONSUMERS=2
WORKER_CV_CONSUMERS=1
WORKER_CV_DEVICE=cpu
MODELS_CACHE_DIR=./models-cache

# --- browser lane ----------------------------------------------------------
# One fresh Camoufox browser per task. Sessions is the concurrency cap; each
# live page is ~700 MB-1.1 GB RSS, so sessions x RSS must fit the memory limit
# (12 on a 16 GB box; tune 8-20 against measured RSS, not guesswork).
WORKER_BROWSER_SESSIONS=12
WORKER_BROWSER_HEADLESS=1
# Refuse to launch a session when free memory drops below this, instead of
# letting the kernel OOM-kill a browser tree mid-task.
WORKER_BROWSER_MIN_FREE_MB=2048
WORKER_BROWSER_CONSUMERS=1
# Camoufox browser build fetched into the image. Bump with the browser lane's
# canary, not on a whim.
CAMOUFOX_VERSION=0.5.6
# Compose resource knobs for worker-browser.
BROWSER_SHM_SIZE=2gb
BROWSER_CPUS=8
BROWSER_MEMORY=16g

# --- hCaptcha JS bundle worker (Node 20) -----------------------------------
# The bundle worker runs as a subprocess of the HTTP worker; node is on PATH in
# the app image and node_modules is installed next to server.js. 1 = full stacks
# on stderr for every failed bundle call (noisy: leave 0 in production).
HCAPTCHA_JS_DEBUG=0

# --- HTTP-first router -----------------------------------------------------
# Escalate a type to the browser lane when its HTTP pass rate drops below the
# threshold inside the window.
HTTP_FALLBACK_THRESHOLD=0.7
HTTP_FALLBACK_WINDOW_SEC=3600

# --- canary ----------------------------------------------------------------
CANARY_INTERVAL_SEC=21600
CANARY_PASS_THRESHOLD=0.9
CANARY_ALERT_WEBHOOK=
CANARY_POLL_INTERVAL_SEC=5
CANARY_TASK_TIMEOUT_SEC=180

# --- security --------------------------------------------------------------
# Empty ADMIN_TOKEN disables /admin/* entirely. Set it in production.
ADMIN_TOKEN=
# Pepper for API-key hashing at rest. Empty still hashes, but loses the
# rainbow-table protection: production sets this to a long random string.
API_KEY_PEPPER=
RATE_LIMIT_CREATE_PER_MIN=60
MAX_ACTIVE_TASKS_PER_ACCOUNT=100
MAX_DAILY_TASKS=10000
MAX_DAILY_SPEND=50
# Contract §7 gate: types whose only solver is experimental=True are withheld
# from the sellable set. The config.py default is 0. Beta may set 1 to reach the
# 42 experimental solvers; production keeps 0.
ALLOW_EXPERIMENTAL_TASKS=0

# --- proxy -----------------------------------------------------------------
PROXY_PROVIDER_PRIMARY=
PROXY_PROVIDER_FALLBACK=
PROXY_POOL_FILE=data/proxies/pool.txt

# --- llm (text captcha) ----------------------------------------------------
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_API_KEY=

# --- observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENDPOINT=
SENTRY_DSN=

# --- 2captcha pingback -----------------------------------------------------
CALLBACK_TIMEOUT_SEC=10
CALLBACK_MAX_ATTEMPTS=3
